# Where the Vite dev server proxies /api and /signin-google. Defaults to the API's https launch profile.
VITE_API_TARGET=https://localhost:7204

# Serve the dev server over https, which Google sign-in needs (see the README). Both or neither.
# VITE_HTTPS_CERT=./certs/localhost.pem
# VITE_HTTPS_KEY=./certs/localhost.key
